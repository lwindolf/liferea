<?xml version="1.0"?>
<opml version="1.0">
  <head>
    <title>Przykładowa lista subskrypcji Liferea 🇵🇱</title>
  </head>
  <body>
    <outline text="Przykładowe Subskrypcje">
      <outline text="Wiadomości IT">
        <outline text="Benchmark.pl" htmlUrl="http://www.benchmark.pl/" xmlUrl="http://www.benchmark.pl/rss/aktualnosci-pliki.xml" />
        <outline text="dobreprogramy" htmlUrl="https://www.dobreprogramy.pl/" xmlUrl="http://feeds.feedburner.com/dobreprogramy/Aktualnosci?format=xml" />
        <outline text="Dziennik Internautów" htmlUrl="http://di.com.pl/" xmlUrl="http://feeds.feedburner.com/glowny-di?format=xml" />
        <outline text="TwojePC.pl" htmlUrl="https://twojepc.pl/" xmlUrl="https://twojepc.pl/news_rss.php" />
      </outline>
      <outline text="Bezpieczeństwo IT"> 
        <outline text="Sekurak" htmlUrl="https://sekurak.pl/" xmlUrl="http://feeds.feedburner.com/Sekurak?format=xml" />
        <outline text="Niebezpiecznik.pl" htmlUrl="https://niebezpiecznik.pl/" xmlUrl="http://feeds.feedburner.com/niebezpiecznik?format=xml" />
      </outline>

      <outline text="międzynarodowe">
		<!-- start of default block: lets keep this default English block in sync over all feed lists! -->
		<outline text="News">
			<outline text="Ars Technica" htmlUrl="https://arstechnica.com" xmlUrl="https://feeds.arstechnica.com/arstechnica/index"/>
			<outline text="Slashdot" htmlUrl="https://slashdot.org"  xmlUrl="https://rss.slashdot.org/Slashdot/slashdotMain" />
			<outline text="BBC" htmlUrl="https://www.bbc.com/news" xmlUrl="https://feeds.bbci.co.uk/news/rss.xml?edition=int"/>
			<outline text="r/worldnews" htmlUrl="https://www.reddit.com/r/worldnews/" xmlUrl="https://www.reddit.com/r/worldnews.rss"/>
		</outline>
		<outline text="Knowledge">
			<outline text="Science" htmlUrl="https://www.sciencenews.org" xmlUrl="https://www.sciencenews.org/feed"/>
			<outline text="Aeon" htmlUrl="https://aeon.co/" xmlUrl="https://aeon.co/feed.rss"/>
			<outline text="Quanta Magazine" htmlUrl="https://api.quantamagazine.org/" xmlUrl="https://api.quantamagazine.org/feed/"/>
			<outline text="bioGraphic" htmlUrl="https://www.biographic.com" xmlUrl="https://www.biographic.com/feed/"/>
		</outline>
		<outline text="Open Source">		<!-- translate this title for localized feed list -->
			<outline text="Liferea Blog" htmlUrl="https://lzone.de/liferea/blog/" xmlUrl="https://lzone.de/feed/liferea.xml" />
			<outline text="Planet GNOME" htmlUrl="https://planet.gnome.org/" xmlUrl="https://planet.gnome.org/atom.xml" />	
		</outline>
		<outline text="Podcasts">		<!-- translate this title for localized feed list -->
			<outline text="EscapePod" htmlUrl="https://escapepod.org" xmlUrl="https://escapepod.org/feed/atom/"/>
			<outline text="Philosophize This!" htmlUrl="https://philosophizethis.org" xmlUrl="https://feeds.megaphone.fm/QCD6036500916"/>
			<outline text="The Rest Is History" htmlUrl="https://therestishistory.com/" xmlUrl="https://feeds.megaphone.fm/GLT4787413333"/>
		</outline>
		<outline text="Comics">
			<outline text="xkcd" htmlUrl="https://xkcd.com/" xmlUrl="https://xkcd.com/atom.xml"/>
		</outline>
		<outline text="Discover Blogs" description="Feeds that help you discover new interesting content. For more content have a look at &lt;a href=&quot;https://lwindolf.github.io/rss-finder&quot;&gt;RSS Finder&lt;/a&gt;.">
			<outline text="bubbles.town" htmlUrl="https://bubbles.town/" xmlUrl="https://bubbles.town/feed"/>
			<outline text="Random Indie blogs" htmlUrl="https://indieblog.page/" xmlUrl="https://indieblog.page/dailyfeed?num=5"/>
			<outline text="kagi smallweb" htmlUrl="https://kagi.com/smallweb" xmlUrl="https://kagi.com/api/v1/smallweb/feed/"/>
		</outline>
		<!-- end of default block -->
      </outline>
    </outline>

  	<!-- the following search folders should also be in sync for all feed lists -->
  	<!-- Do only translate the @text attributes in all of the following <outline> tags! -->
    <outline text="Nie przeczytane" title="Nie przeczytane" description="Nie przeczytane" type="vfolder" htmlUrl="" xmlUrl="vfolder">
      <outline type="rule" text="Read status" rule="unread" value="" additive="true"/>
    </outline>
    <outline text="Oznaczone" title="Oznaczone" description="Oznaczone" type="vfolder" htmlUrl="" xmlUrl="vfolder" totalCount="true">
      <outline type="rule" text="Flag status" rule="flagged" value="" additive="true"/>
    </outline>
    <!-- end of search folder block -->
  </body>
</opml>
